# Database
DATABASE_URL=sqlite:///./booktrack.db
# Para Postgres: postgresql+psycopg2://postgres:postgres@db:5432/booktrack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=booktrack

# External APIs
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# AI fallback (use uma das duas — Anthropic é tentado primeiro)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Auth Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
JWT_SECRET=
JWT_EXPIRES_DAYS=30

# App
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
